<!-- $Id$ -->
<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
  <Script file="MainFrame.lua"/>

  <Frame name="TFuBag_MainTemplate" inherits="BackdropTemplate" toplevel="true" frameStrata="MEDIUM" movable="true" enableMouse="true" hidden="true" parent="UIParent" virtual="true">
    <!-- Inline <Backdrop> removed from XML in 9.0; set via BackdropTemplate
         mixin in OnLoad below. -->
    <Frames>
      <Button name="$parent_ColumnsAdd" inherits="TFuBag_ColumnsButtonTemplate"/>
      <Button name="$parent_ColumnsDel" inherits="TFuBag_ColumnsButtonTemplate"/>
      <Frame name="$parent_Total" hidden="false" inherits="TFuBag_TotalTemplate"/>
      <Frame name="$parent_MoneyFrame" hidden="false" inherits="SmallMoneyFrameTemplate">
        <Size><AbsDimension x="22" y="25"/></Size>
        <Scripts>
          <OnLoad>
            SmallMoneyFrame_OnLoad(self)
            MoneyFrame_SetType(self, "STATIC")
          </OnLoad>
        </Scripts>
      </Frame>
      <Frame name="$parent_TokenFrame" hidden="false" inherits="TFuBag_TokenFrameTemplate"/>
    </Frames>
    <Scripts>
      <OnLoad>
        self:SetBackdrop({
          bgFile = "Interface\\Tooltips\\UI-Tooltip-Background",
          edgeFile = "Interface\\Tooltips\\UI-Tooltip-Border",
          tile = true, tileSize = 8, edgeSize = 8,
          insets = { left = 3, right = 3, top = 3, bottom = 3 },
        })
        -- Keep the window fully on-screen: prevents dragging it off the edge
        -- (where WoW reverts the un-placed off-screen drop back to the pre-move
        -- position) and prevents losing the window.
        self:SetClampedToScreen(true)
        table.insert(UISpecialFrames, self:GetName())
      </OnLoad>
      <OnShow>
        self:OnShow()
      </OnShow>
      <OnHide>
        self:OnHide()
      </OnHide>
      <OnDragStart>
        self:DragStart()
      </OnDragStart>
      <OnDragStop>
        self:DragStop()
      </OnDragStop>
      <OnMouseDown>
        self:OnMouseDown(button)
      </OnMouseDown>
      <OnMouseUp>
        self:DragStop()
      </OnMouseUp>
    </Scripts>
  </Frame>
</Ui>

