      <Frame name="$parent_RightClickMenu" inherits="UIDropDownMenuTemplate" id="1" hidden="true">
        <Scripts>
          <OnLoad>
            self:RegisterEvent("VARIABLES_LOADED");
          </OnLoad>
          <OnEvent>
            TFuBag.Bank.RightClickMenu_OnLoad(self);
          </OnEvent>
