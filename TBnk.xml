          </Anchor>
        </Anchors>
      </CheckButton>
      <CheckButton name="TFuBnkFrameBag2" inherits="TFuBag_BagButtonTemplate" id="6">
        <Anchors>
          <Anchor point="BOTTOMLEFT" relativeTo="TFuBnkFrameBag1" relativePoint="BOTTOMRIGHT">
            <Offset>
              <AbsDimension x="3" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
      </CheckButton>
      <CheckButton name="TFuBnkFrameBag3" inherits="TFuBag_BagButtonTemplate" id="7">
        <Anchors>
          <Anchor point="BOTTOMLEFT" relativeTo="TFuBnkFrameBag2" relativePoint="BOTTOMRIGHT">
            <Offset>
              <AbsDimension x="3" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
      </CheckButton>
      <CheckButton name="TFuBnkFrameBag4" inherits="TFuBag_BagButtonTemplate" id="8">
        <Anchors>
          <Anchor point="BOTTOMLEFT" relativeTo="TFuBnkFrameBag3" relativePoint="BOTTOMRIGHT">
            <Offset>
              <AbsDimension x="3" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
      </CheckButton>
      <CheckButton name="TFuBnkFrameBag5" inherits="TFuBag_BagButtonTemplate" id="9">
        <Anchors>
          <Anchor point="BOTTOMLEFT" relativeTo="TFuBnkFrameBag4" relativePoint="BOTTOMRIGHT">
            <Offset>
              <AbsDimension x="3" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
      </CheckButton>
      <CheckButton name="TFuBnkFrameBag6" inherits="TFuBag_BagButtonTemplate" id="10">
        <Anchors>
          <Anchor point="BOTTOMLEFT" relativeTo="TFuBnkFrameBag5" relativePoint="BOTTOMRIGHT">
            <Offset>
              <AbsDimension x="3" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
      </CheckButton>
      <CheckButton name="TFuBnkFrameBag7" inherits="TFuBag_BagButtonTemplate" id="11">
        <Anchors>
          <Anchor point="BOTTOMLEFT" relativeTo="TFuBnkFrameBag6" relativePoint="BOTTOMRIGHT">
            <Offset>
              <AbsDimension x="3" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
      </CheckButton>

  <Frame name="TFuBnkainerFrame3" inherits="TFuBagainerFrameTemplate" id="0"/>
  <Frame name="TFuBnkainerFrame4" inherits="TFuBagainerFrameTemplate" id="0"/>
  <Frame name="TFuBnkainerFrame5" inherits="TFuBagainerFrameTemplate" id="5"/>
