  <Button name="TBnk_SlotTargetTemplate" inherits="ItemButtonTemplate" hidden="true" virtual="true">
    <Size>
      <AbsDimension x="40" y="40"/>
    </Size>
    <Anchors>
      <Anchor point="BOTTOMRIGHT">
        <Offset>
          <AbsDimension x="0" y="0"/>
        </Offset>
      </Anchor>
    </Anchors>
    <Layers>
      <Layer level="OVERLAY">
        <FontString name="$parent_BigText" inherits="TBag_BigFont" justifyH="CENTER">
          <Anchors>
            <Anchor point="LEFT" relativePoint="LEFT">
              <Offset><AbsDimension x="-2" y="0"/></Offset>
            </Anchor>
            <Anchor point="RIGHT" relativePoint="RIGHT">
              <Offset><AbsDimension x="2" y="0"/></Offset>
            </Anchor>
          </Anchors>
        </FontString>
      </Layer>
      <Layer frameStrata="BORDER">
        <Texture name="$parent_bkgr" inherits="TBag_ButtonBkgrTemplate"/>
      </Layer>
    </Layers>
    <Scripts>
      <OnClick>
        TBnk_SlotTargetButton_OnClick(arg1);
      </OnClick>
      <OnDragStart>
        TBnk_SlotTargetButton_OnClick("LeftButton", 1);
      </OnDragStart>
      <OnReceiveDrag>
        TBnk_SlotTargetButton_OnClick("LeftButton", 1);
      </OnReceiveDrag>
      <OnLoad>
        this:RegisterForClicks("LeftButtonUp", "RightButtonUp");
        this:RegisterForDrag("LeftButton");
	ContainerFrameItemButton_OnLoad();	
	this.UpdateTooltip = TBnk_SlotTargetButton_OnEnter;
      </OnLoad>
      <OnHide>
        if ( this.hasStackSplit and (this.hasStackSplit == 1) ) then
          StackSplitFrame:Hide();
        end
      </OnHide>
      <OnEnter>
        TBnk_SlotTargetButton_OnEnter(self);
      </OnEnter>
      <OnLeave>
        TBnk_SlotTargetButton_OnLeave();
      </OnLeave>
    </Scripts>
  </Button>

  <CheckButton name="TBnk_BankBagTemplate" inherits="BankItemButtonGenericTemplate" virtual="true">
    <Size><AbsDimension x="40" y="40"/></Size>
		<Scripts>
			<OnLoad>
				BankFrameBagButton_OnLoad();
				this.UpdateTooltip = TBnk_BankBagButton_OnEnter;
			</OnLoad>
			<OnClick>
				if ( IsModifiedClick("PICKUPACTION") ) then
					BankFrameItemButtonBag_Pickup();
				else
					BankFrameItemButtonBag_OnClick(arg1);
				end
			</OnClick>
	        <OnDragStart>
	            BankFrameItemButtonBag_Pickup();
	        </OnDragStart>
	        <OnReceiveDrag>
	            BankFrameItemButtonBag_OnClick();
	        </OnReceiveDrag>
      <OnEnter>
        TBnk_BankBagButton_OnEnter(self);
      </OnEnter>
		</Scripts>
		<Frames>
			<Frame name="$parentHighlightFrame" setAllPoints="true">
				<Layers>
					<Layer>
						<Texture name="$parentTexture" alphaMode="ADD" file="Interface\Buttons\CheckButtonHilight" setAllPoints="true" hidden="true"/>									
					</Layer>
				</Layers>
			</Frame>
      <Frame name="$parentSpotlight" setAllPoints="true">
