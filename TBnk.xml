<!-- $Id$ -->
<Ui xmlns="http://www.blizzard.com/wow/ui/"   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"   xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
  <Script file="TBnk.lua"/>

  <Frame name="TFuBnkFrame" inherits="TFuBag_MainTemplate">
    <Frames>
      <Button name="TFuBnk_Button_Close">
        <Size><AbsDimension x="34" y="34"/></Size>
        <NormalTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Up" />
        <PushedTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Down" />
        <HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD" />
        <Anchors>
          <Anchor point="TOPRIGHT">
            <Offset>
              <AbsDimension x="0" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            TFuBnkFrame:Hide();
          </OnClick>
        </Scripts>
      </Button>

      <Button name="TFuBnk_Button_MoveLockToggle">
        <Size><AbsDimension x="34" y="34"/></Size>
        <NormalTexture name="TFuBnkLockNorm" />
        <PushedTexture name="TFuBnkLockPush" />
        <HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD" />

        <Anchors>
          <Anchor point="TOPRIGHT" relativeTo="TFuBnk_Button_Close" relativePoint="TOPLEFT">
            <Offset>
              <AbsDimension x="10" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            TFuBnkFrame.Button_MoveLockToggle_OnClick(self, button, down);
          </OnClick>
          <OnEnter>
            if (TFuBnkFrame.cfg["moveLock"] == 0) then
              TFuBag.NewbieTip(self, TFuBag.LOCALE["Unlock Window"], 1.0, 1.0, 1.0,
                                       TFuBag.LOCALE["Allow window to be moved by dragging it."]);
            else
              TFuBag.NewbieTip(self, TFuBag.LOCALE["Lock Window"], 1.0, 1.0, 1.0,
                                       TFuBag.LOCALE["Prevent window from being moved by dragging it."]);
            end
          </OnEnter>
          <OnLeave>
            GameTooltip:Hide();
            ResetCursor();
          </OnLeave>
        </Scripts>
      </Button>

      <Frame name="TFuBnk_UserDropdown" inherits="TFuBag_UserDropdownTemplate">
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset>
              <AbsDimension x="-10" y="-5"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnShow>
            TFuBnkFrame.UserDropdown_OnLoad(self);
          </OnShow>
        </Scripts>
      </Frame>


      <Button name="TFuBnk_Button_HighlightToggle">
        <Size><AbsDimension x="20" y="20"/></Size>
        <NormalTexture file="Interface\Icons\INV_Misc_Gem_Pearl_04" />
        <PushedTexture file="Interface\Icons\INV_Misc_Gem_Pearl_04" />
        <HighlightTexture file="Interface\Icons\INV_Misc_Gem_Pearl_04" alphaMode="ADD" />
        <Anchors>
        <Anchor point="TOPLEFT" relativeTo="TFuBnk_UserDropdown" relativePoint="TOPRIGHT">
            <Offset>
              <AbsDimension x="15" y="-3"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            TFuBnkFrame.Button_HighlightToggle_OnClick(self, button, down);
          </OnClick>
          <OnEnter>
            if (TFuBag.SrchText) then
              TFuBag.NewbieTip(self, TFuBag.LOCALE["Clear Search"], 1.0, 1.0, 1.0, TFuBag.LOCALE["Stop highlighting search results."]);
            elseif (TFuBnkFrame.hilight_new == 0) then
              TFuBag.NewbieTip(self, TFuBag.LOCALE["Highlight New"], 1.0, 1.0, 1.0, TFuBag.LOCALE["Highlight items marked as new."]);
            else
              TFuBag.NewbieTip(self, TFuBag.LOCALE["Normal"], 1.0, 1.0, 1.0, TFuBag.LOCALE["Stop highlighting new items."]);
            end
          </OnEnter>
          <OnLeave>
            GameTooltip:Hide();
            ResetCursor();
          </OnLeave>
        </Scripts>
      </Button>

      <Button name="TFuBnk_Button_ChangeEditMode">
        <Size><AbsDimension x="20" y="20"/></Size>
        <NormalTexture file="Interface\Icons\Trade_Engineering" />
        <PushedTexture file="Interface\Icons\Trade_Engineering" />
        <HighlightTexture file="Interface\Icons\Trade_Engineering" alphaMode="ADD" />
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="TFuBnk_Button_HighlightToggle" relativePoint="TOPRIGHT">
            <Offset>
              <AbsDimension x="2" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            TFuBnkFrame.Button_ChangeEditMode_OnClick(self, button, down);
          </OnClick>
          <OnEnter>
            TFuBag.NewbieTip(self, TFuBag.LOCALE["Toggle Edit Mode"], 1.0, 1.0, 1.0, TFuBag.LOCALE["Select this option to move classes of items into different 'bars' (the red numbers)."]);
          </OnEnter>
          <OnLeave>
            GameTooltip:Hide();
            ResetCursor();
          </OnLeave>
        </Scripts>
      </Button>

      <Button name="TFuBnk_Button_Reload">
        <Size><AbsDimension x="20" y="20"/></Size>
        <NormalTexture file="Interface\Icons\Spell_Frost_Stun" />
        <PushedTexture file="Interface\Icons\Spell_Frost_Stun" />
        <HighlightTexture file="Interface\Icons\Spell_Frost_Stun" alphaMode="ADD" />
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="TFuBnk_Button_ChangeEditMode" relativePoint="TOPRIGHT">
            <Offset>
              <AbsDimension x="2" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            TFuBnkFrame.Button_Reload_OnClick(self, button, down);
          </OnClick>
          <OnEnter>
            TFuBag.NewbieTip(self, TFuBag.LOCALE["Reload and Sort"], 1.0, 1.0, 1.0, TFuBag.LOCALE["Reloads your items and sorts them."]);
          </OnEnter>
          <OnLeave>
            GameTooltip:Hide();
            ResetCursor();
          </OnLeave>
        </Scripts>
      </Button>

      <Button name="TFuBnk_Button_DepositReagent">
        <Size><AbsDimension x="20" y="20"/></Size>
        <NormalTexture file="Interface\Icons\INV_Misc_Bag_SatchelofCenarius.blp" />
        <PushedTexture file="Interface\Icons\INV_Misc_Bag_SatchelofCenarius.blp" />
        <HighlightTexture file="Interface\Icons\INV_Misc_Bag_SatchelofCenarius.blp" alphaMode="ADD" />
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="TFuBnk_Button_Reload" relativePoint="TOPRIGHT">
            <Offset>
              <AbsDimension x="2" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            TFuBnkFrame.Button_DepositReagent_OnClick(self, button, down);
          </OnClick>
          <OnEnter>
            TFuBag.NewbieTip(self, REAGENTBANK_DEPOSIT, 1.0, 1.0, 1.0, TFuBag.LOCALE["Deposits all Reagents in your bag."]);
          </OnEnter>
          <OnLeave>
            GameTooltip:Hide();
            ResetCursor();
          </OnLeave>
        </Scripts>
      </Button>

      <CheckButton name="TFuBnkFrameBagBank" inherits="TFuBag_BagButtonTemplate" id="-1">
        <Anchors>
          <Anchor point="BOTTOMLEFT" relativeTo="$parent_Total" relativePoint="BOTTOMRIGHT">
            <Offset>
              <AbsDimension x="3" y="2"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnLoad>
            TFuBag.BagButton.OnLoad(self)
            self:SetID(BANK_CONTAINER)
          </OnLoad>
        </Scripts>
      </CheckButton>
      <CheckButton name="TFuBnkFrameBagReagent" inherits="TFuBag_BagButtonTemplate" id="-3">
        <Anchors>
          <Anchor point="LEFT" relativeTo="TFuBnkFrameBagBank" relativePoint="RIGHT">
            <Offset>
              <AbsDimension x="3" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnLoad>
            TFuBag.BagButton.OnLoad(self)
            self:SetID(REAGENTBANK_CONTAINER)
          </OnLoad>
        </Scripts>
      </CheckButton>
      <CheckButton name="TFuBnkFrameBag1" inherits="TFuBag_BagButtonTemplate" id="5">
        <Anchors>
          <Anchor point="LEFT" relativeTo="TFuBnkFrameBagReagent" relativePoint="RIGHT">
            <Offset>
              <AbsDimension x="3" y="0"/>
