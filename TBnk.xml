  <Button name="TBnk_BankItemButtonTemplate" inherits="BankItemButtonGenericTemplate" hidden="true" virtual="true">
    <Size>
      <AbsDimension x="40" y="40"/>
    </Size>
    <Anchors>
      <Anchor point="CENTER">
        <Offset>
          <AbsDimension x="0" y="0"/>
        </Offset>
      </Anchor>
    </Anchors>
    <Frames>
      <Button name="$parent_EditButton" hidden="true">
        <Size>
          <AbsDimension x="40" y="40"/>
        </Size>
        <Anchors>
          <Anchor point="CENTER">
            <Offset>
              <AbsDimension x="0" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnLoad>
            this:RegisterForClicks("LeftButtonUp", "RightButtonUp");
          </OnLoad>
          <OnClick>
            TBnk_ItemButton_OnClick(arg1);
          </OnClick>
          <OnEnter>
            TBnk_ItemButton_OnEnter(self);
          </OnEnter>
          <OnLeave>
            TBnk_ItemButton_OnLeave();
          </OnLeave>
        </Scripts>
      </Button>
      <Cooldown name="$parent_Cooldown" inherits="CooldownFrameTemplate"/>
      <Frame name="$parentHighlightFrame" setAllPoints="true">
        <Layers>
          <Layer>
            <Texture name="$parentTexture" alphaMode="ADD" file="Interface\Buttons\CheckButtonHilight" setAllPoints="true" hidden="true"/>                  
          </Layer>
        </Layers>
      </Frame>
    </Frames>
    <Layers>
      <Layer frameStrata="BORDER">
        <Texture name="$parent_bkgr" inherits="TBag_ButtonBkgrTemplate"/>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad>
        this:RegisterEvent("MODIFIER_STATE_CHANGED");
        this:RegisterForClicks("LeftButtonUp", "RightButtonUp");	   
        BankFrameItemButton_OnLoad();
	this.UpdateTooltip = TBnk_ItemButton_OnEnter;
      </OnLoad>
      <OnEnter>
        TBnk_ItemButton_OnEnter(self);
      </OnEnter>
      <OnLeave>
        TBnk_ItemButton_OnLeave();
      </OnLeave>
    </Scripts>
  </Button>

