    <Frames>
      <Button name="TBnk_Button_ColumnsAdd" visible="true" inherits="GameMenuButtonTemplate" text="++">
        <Size><AbsDimension x="45" y="22"/></Size>
        <Anchors>
          <Anchor point="CENTER" relativePoint="CENTER">
            <OffSet>
              <AbsDimension x="24" y="0"/>
            </OffSet>
          </Anchor>
          <Anchor point="BOTTOM" relativePoint="BOTTOM">
            <Offset>
              <AbsDimension x="0" y="5"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            PlaySound("igMainMenuOptionCheckBoxOn");
            TBnk_IncreaseColumns();
          </OnClick>
          <OnEnter>
            GameTooltip_AddNewbieTip(
              TBAG_LOCALE["Window Size"],
              1.0, 1.0, 1.0,
              TBAG_LOCALE["Increase the number of columns displayed"] );
          </OnEnter>
          <OnLeave>
            GameTooltip:Hide();
            ResetCursor();
          </OnLeave>
        </Scripts>
      </Button>

      <Button name="TBnk_Button_ColumnsDel" visible="true" inherits="GameMenuButtonTemplate" text="--">
        <Size><AbsDimension x="45" y="22"/></Size>
        <Anchors>
          <Anchor point="CENTER" relativePoint="CENTER">
            <OffSet>
              <AbsDimension x="-24" y="0"/>
            </OffSet>
          </Anchor>
          <Anchor point="BOTTOM" relativePoint="BOTTOM">
            <Offset>
              <AbsDimension x="0" y="5"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>

          <OnClick>
            PlaySound("igMainMenuOptionCheckBoxOn");
            TBnk_DecreaseColumns();
          </OnClick>

          <OnEnter>
            GameTooltip_AddNewbieTip(
              TBAG_LOCALE["Window Size"],
              1.0, 1.0, 1.0,
	      TBAG_LOCALE["Decrease the number of columns displayed"] );
          </OnEnter>
          <OnLeave>
            GameTooltip:Hide();
            ResetCursor();
          </OnLeave>
        </Scripts>
      </Button>


