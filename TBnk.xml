  <Button name="TBnk_SlotTargetTemplate" inherits="ItemButtonTemplate" hidden="true" virtual="true">
    <Size>
      <AbsDimension x="40" y="40"/>
    </Size>
    <Anchors>
      <Anchor point="BOTTOMRIGHT">
        <Offset>
          <AbsDimension x="0" y="0"/>
