        </FontString>
      </Layer>
      <Layer frameStrata="BORDER">
        <Texture name="$parent_bkgr" inherits="TBag_ButtonBkgrTemplate"/>
      </Layer>
    </Layers>
    <Scripts>
      <OnClick>
        TBnk_SlotTargetButton_OnClick(arg1);
      </OnClick>
      <OnDragStart>
        TBnk_SlotTargetButton_OnClick("LeftButton", 1);
      </OnDragStart>
      <OnReceiveDrag>
        TBnk_SlotTargetButton_OnClick("LeftButton", 1);
      </OnReceiveDrag>
      <OnLoad>
        this:RegisterForClicks("LeftButtonUp", "RightButtonUp");
        this:RegisterForDrag("LeftButton");
        ContainerFrameItemButton_OnLoad();	
      </OnLoad>
      <OnHide>
        if ( this.hasStackSplit and (this.hasStackSplit == 1) ) then
          StackSplitFrame:Hide();
        end
      </OnHide>
      <OnEnter>
        TBnk_SlotTargetButton_OnEnter();
      </OnEnter>
      <OnLeave>
        TBnk_SlotTargetButton_OnLeave();
      </OnLeave>
      <OnUpdate>
        TBnk_SlotTargetButton_OnUpdate(arg1);
      </OnUpdate>
    </Scripts>
  </Button>

