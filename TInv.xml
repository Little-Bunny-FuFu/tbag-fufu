              1.0, 1.0, 1.0,
	      TBAG_LOCALE["Decrease the number of columns displayed"] );
          </OnEnter>
          <OnLeave>
            GameTooltip:Hide();
            ResetCursor();
          </OnLeave>
        </Scripts>
      </Button>


      <Button name="TInv_Button_Close" inherits="GameMenuButtonTemplate" text="X">
