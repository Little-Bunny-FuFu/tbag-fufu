	    GameTooltip_AddNewbieTip(TBAG_LOCALE["Hilight"], 1.0, 1.0, 1.0, TBAG_LOCALE["Highlight of new items is OFF."]);
            else
	    GameTooltip_AddNewbieTip(TBAG_LOCALE["Normal"], 1.0, 1.0, 1.0, TBAG_LOCALE["Highlight of new items is ON."]);
            end
