      <CheckButton name="TInvMenuBarBackpackButton" inherits="ItemButtonTemplate" id="0">
        <Anchors>
          <Anchor point="LEFT" relativeTo="TInvacterBag0Slot" relativePoint="RIGHT">
            <Offset>
              <AbsDimension x="3" y="0" />
            </Offset>
          </Anchor>
        </Anchors>
        <Frames>
          <Model name="$parentItemAnim" inherits="ItemAnimTemplate"/>
      <Frame name="$parentSpotlight" setAllPoints="true">
        <Layers>
          <Layer>
            <Texture name="$parentTexture" alphaMode="ADD" file="Interface\Buttons\CheckButtonHilight" setAllPoints="true" hidden="true"/>                  
          </Layer>
        </Layers>
      </Frame>
      <Frame name="$parentHighlightFrame" setAllPoints="true">
        <Layers>
          <Layer>
            <Texture name="$parentTexture" alphaMode="ADD" file="Interface\Buttons\CheckButtonHilight" setAllPoints="true" hidden="true"/>                  
          </Layer>
        </Layers>
      </Frame>
        </Frames>
        <Scripts>
          <OnLoad>
            this:RegisterForClicks("LeftButtonUp", "RightButtonUp");
            TInvMenuBarBackpackButtonIconTexture:SetTexture("Interface\\Buttons\\Button-Backpack-Up");
          </OnLoad>
	  <OnClick>
	    if ( IsModifiedClick() ) then
              BackpackButton_OnModifiedClick();
	    else
	      BackpackButton_OnClick();
	    end
          </OnClick>
          <OnReceiveDrag>
            BackpackButton_OnClick();
          </OnReceiveDrag>
          <OnEnter>
            GameTooltip:SetOwner(this, "ANCHOR_LEFT");
            GameTooltip:SetText(TEXT(BACKPACK_TOOLTIP), 1.0, 1.0, 1.0);
            local keyBinding = GetBindingKey("TOGGLEBACKPACK");
            if ( keyBinding ) then
              GameTooltip:AppendText(" "..NORMAL_FONT_COLOR_CODE.."("..keyBinding..")"..FONT_COLOR_CODE_CLOSE);
            end
          </OnEnter>
          <OnLeave>
            GameTooltip:Hide();
          </OnLeave>
        </Scripts>
        <CheckedTexture alphaMode="ADD" file="Interface\Buttons\CheckButtonHilight"/>
      </CheckButton>

  <CheckButton name="TInvingButton">
    <Size x="18" y="39"/>
    <Anchors>
          <Anchor point="BOTTOMLEFT" relativeTo="TInvMenuBarBackpackButton" relativePoint="BOTTOMRIGHT">
