    <Frames>
      <Button name="TInv_Button_ColumnsAdd" inherits="GameMenuButtonTemplate" text="++">
        <Size><AbsDimension x="45" y="22"/></Size>
        <Anchors>
          <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOM">
            <Offset>
              <AbsDimension x="38" y="-22"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>

          <OnClick>
            PlaySound("igMainMenuOptionCheckBoxOn");
            TInv_IncreaseColumns();
          </OnClick>

          <OnEnter>
            GameTooltip_AddNewbieTip(
	      TBAG_LOCALE["Window Size"],
              1.0, 1.0, 1.0,
	      TBAG_LOCALE["Increase the number of columns displayed"] );
          </OnEnter>
          <OnLeave>
            GameTooltip:Hide();
            ResetCursor();
          </OnLeave>
        </Scripts>
      </Button>

      <Button name="TInv_Button_ColumnsDel" inherits="GameMenuButtonTemplate" text="--">
        <Size><AbsDimension x="45" y="22"/></Size>
        <Anchors>
          <Anchor point="BOTTOMLEFT" relativePoint="BOTTOM">
            <Offset>
              <AbsDimension x="42" y="-22"/>
            </Offset>
