  <Button name="TInv_ItemButtonTemplate" inherits="ContainerFrameItemButtonTemplate" hidden="true" virtual="true">
    <Size>
      <AbsDimension x="40" y="40"/>
    </Size>
    <Anchors>
      <Anchor point="CENTER">
        <Offset>
          <AbsDimension x="0" y="0"/>
        </Offset>
      </Anchor>
    </Anchors>
    <Frames>
      <Cooldown name="$parent_Cooldown" inherits="CooldownFrameTemplate"/>
      <Frame name="$parentHighlightFrame" setAllPoints="true">
        <Layers>
          <Layer>
            <Texture name="$parentTexture" alphaMode="ADD" file="Interface\Buttons\CheckButtonHilight" setAllPoints="true" hidden="true"/>
          </Layer>
        </Layers>
      </Frame>
    </Frames>
    <Layers>
      <Layer frameStrata="BORDER">
        <Texture name="$parent_bkgr" inherits="TBag_ButtonBkgrTemplate"/>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad>
        ContainerFrameItemButton_OnLoad();
        this.UpdateTooltip = TInv_ItemButton_OnEnter;
      </OnLoad>
      <OnEnter>
        TInv_ItemButton_OnEnter(self);
      </OnEnter>
      <OnLeave>
        TInv_ItemButton_OnLeave();
      </OnLeave>
    </Scripts>
  </Button>

  <Button name="TInv_SlotTargetTemplate" inherits="ItemButtonTemplate" hidden="true" virtual="true">
    <Size>
      <AbsDimension x="40" y="40"/>
    </Size>
    <Anchors>
      <Anchor point="BOTTOMRIGHT">
        <Offset>
          <AbsDimension x="0" y="0"/>
        </Offset>
      </Anchor>
    </Anchors>
    <Layers>
      <Layer level="OVERLAY">
        <FontString name="$parent_BigText" inherits="TBag_BigFont">
          <Anchors>
            <Anchor point="LEFT" relativePoint="LEFT">
              <Offset><AbsDimension x="-2" y="0"/></Offset>
            </Anchor>
            <Anchor point="RIGHT" relativePoint="RIGHT">
              <Offset><AbsDimension x="2" y="0"/></Offset>
            </Anchor>
          </Anchors>
        </FontString>
      </Layer>
      <Layer frameStrata="BORDER">
        <Texture name="$parent_bkgr" inherits="TBag_ButtonBkgrTemplate"/>
      </Layer>
    </Layers>
    <Scripts>
      <OnClick>
        TInv_SlotTargetButton_OnClick(arg1);
      </OnClick>
      <OnDragStart>
        TInv_SlotTargetButton_OnClick("LeftButton", 1);
      </OnDragStart>
      <OnReceiveDrag>
        TInv_SlotTargetButton_OnClick("LeftButton", 1);
      </OnReceiveDrag>
      <OnLoad>
        this:RegisterForClicks("LeftButtonUp", "RightButtonUp");
        this:RegisterForDrag("LeftButton");
      </OnLoad>
      <OnHide>
        if ( this.hasStackSplit and (this.hasStackSplit == 1) ) then
          StackSplitFrame:Hide();
        end
      </OnHide>
      <OnEnter>
        TInv_SlotTargetButton_OnEnter(self);
      </OnEnter>
      <OnLeave>
        TInv_SlotTargetButton_OnLeave();
      </OnLeave>
    </Scripts>
  </Button>

