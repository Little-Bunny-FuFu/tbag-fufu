      <Button name="TInv_Button_MoveLockToggle" inherits="GameMenuButtonTemplate" text="U">
        <Size><AbsDimension x="22" y="25"/></Size>
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="TInv_Button_Close" relativePoint="TOPRIGHT">
            <Offset>
              <AbsDimension x="2" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            TInv_Button_MoveLockToggle_OnClick();
          </OnClick>
          <OnEnter>
            if (TInvCfg["moveLock"] == 0) then
              GameTooltip_AddNewbieTip("Window Dragging: Off", 1.0, 1.0, 1.0, "Window is currently locked in place.");
            else
              GameTooltip_AddNewbieTip("Window Dragging: On", 1.0, 1.0, 1.0, "Window is currently unlocked.");
            end
          </OnEnter>
          <OnLeave>
            GameTooltip:Hide();
            ResetCursor();
          </OnLeave>
        </Scripts>
      </Button>

      <Button name="TInv_Button_HighlightToggle" inherits="GameMenuButtonTemplate" text="Hilight">
        <Size><AbsDimension x="65" y="25"/></Size>
        <Anchors>
        <Anchor point="TOPLEFT" relativeTo="TInv_Button_MoveLockToggle" relativePoint="TOPRIGHT">
            <Offset>
