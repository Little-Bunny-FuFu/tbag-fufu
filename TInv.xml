<!-- $Id$ -->
<Ui xmlns="http://www.blizzard.com/wow/ui/"   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"   xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
  <Script file="TInv.lua"/>

  <Frame name="TFuInvFrame" inherits="TFuBag_MainTemplate">
    <Frames>
      <Button name="TFuInv_Button_Close">
        <Size><AbsDimension x="34" y="34"/></Size>
        <NormalTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Up" />
        <PushedTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Down" />
        <HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD" />
        <Anchors>
          <Anchor point="TOPRIGHT">
            <Offset>
              <AbsDimension x="0" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            TFuInvFrame:Hide()
          </OnClick>
        </Scripts>
      </Button>

      <Button name="TFuInv_Button_MoveLockToggle">
        <Size><AbsDimension x="34" y="34"/></Size>
        <NormalTexture name="TFuInvLockNorm"/>
        <PushedTexture name="TFuInvLockPush"/>
        <HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" AlphaMode="ADD"/>
        <Anchors>
          <Anchor point="TOPRIGHT" relativeTo="TFuInv_Button_Close" relativePoint="TOPLEFT">
            <Offset>
              <AbsDimension x="10" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            TFuInvFrame.Button_MoveLockToggle_OnClick(self, button);
          </OnClick>
          <OnEnter>
            if (TFuInvFrame.cfg["moveLock"] == 0) then
              TFuBag.NewbieTip(self, TFuBag.LOCALE["Unlock Window"], 1.0, 1.0, 1.0,
                                       TFuBag.LOCALE["Allow window to be moved by dragging it."]);
            else
              TFuBag.NewbieTip(self, TFuBag.LOCALE["Lock Window"], 1.0, 1.0, 1.0,
                                       TFuBag.LOCALE["Prevent window from being moved by dragging it."]);
            end
          </OnEnter>
          <OnLeave>
            GameTooltip:Hide();
            ResetCursor();
          </OnLeave>
        </Scripts>
      </Button>

      <Frame name="TFuInv_UserDropdown" inherits="TFuBag_UserDropdownTemplate">
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset>
              <AbsDimension x="-10" y="-5"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnShow>
            TFuInvFrame.UserDropdown_OnLoad(self);
          </OnShow>
        </Scripts>
      </Frame>


      <Button name="TFuInv_Button_HighlightToggle">
        <Size><AbsDimension x="20" y="20"/></Size>
        <NormalTexture file="Interface\Icons\INV_Misc_Gem_Pearl_04" />
        <PushedTexture file="Interface\Icons\INV_Misc_Gem_Pearl_04" />
        <HighlightTexture file="Interface\Icons\INV_Misc_Gem_Pearl_04" alphaMode="ADD" />
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="TFuInv_UserDropdown" relativePoint="TOPRIGHT">
            <Offset>
              <AbsDimension x="15" y="-3"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            TFuInvFrame.Button_HighlightToggle_OnClick(self, button, down);
          </OnClick>
          <OnEnter>
            if (TFuBag.SrchText) then
              TFuBag.NewbieTip(self, TFuBag.LOCALE["Clear Search"], 1.0, 1.0, 1.0, TFuBag.LOCALE["Stop highlighting search results."]);
            elseif (TFuInvFrame.hilight_new == 0) then
              TFuBag.NewbieTip(self, TFuBag.LOCALE["Highlight New"], 1.0, 1.0, 1.0, TFuBag.LOCALE["Highlight items marked as new."]);
            else
              TFuBag.NewbieTip(self, TFuBag.LOCALE["Normal"], 1.0, 1.0, 1.0, TFuBag.LOCALE["Stop highlighting new items."]);
            end
          </OnEnter>
          <OnLeave>
            GameTooltip:Hide();
            ResetCursor();
          </OnLeave>
        </Scripts>
      </Button>

      <Button name="TFuInv_Button_ChangeEditMode">
        <Size><AbsDimension x="20" y="20"/></Size>
        <NormalTexture file="Interface\Icons\Trade_Engineering" />
        <PushedTexture file="Interface\Icons\Trade_Engineering" />
        <HighlightTexture file="Interface\Icons\Trade_Engineering" alphaMode="ADD" />
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="TFuInv_Button_HighlightToggle" relativePoint="TOPRIGHT">
            <Offset>
              <AbsDimension x="2" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            TFuInvFrame.Button_ChangeEditMode_OnClick(self, button, down);
          </OnClick>
          <OnEnter>
            if (TFuInvFrame.cfg and TFuInvFrame.cfg["legacy_edit"] == 1) then
              TFuBag.NewbieTip(self, TFuBag.LOCALE["Toggle Edit Mode"], 1.0, 1.0, 1.0, TFuBag.LOCALE["Select this option to move classes of items into different 'bars' (the red numbers)."]);
            else
              TFuBag.NewbieTip(self, TFuBag.LOCALE["Manual Layout"], 1.0, 1.0, 1.0, TFuBag.LOCALE["Drag categories to arrange them freely. Off uses the automatic layout."]);
            end
          </OnEnter>
          <OnLeave>
            GameTooltip:Hide();
            ResetCursor();
          </OnLeave>
        </Scripts>
      </Button>


      <Button name="TFuInv_Button_ShowBank" inherits="GameMenuButtonTemplate">
        <Size><AbsDimension x="20" y="20"/></Size>
        <NormalTexture file="Interface\Icons\INV_Box_03" />
        <PushedTexture file="Interface\Icons\INV_Box_03" />
        <HighlightTexture file="Interface\Icons\INV_Box_03" alphaMode="ADD" />
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="TFuInv_Button_ChangeEditMode" relativePoint="TOPRIGHT">
            <Offset>
              <AbsDimension x="2" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            TFuInvFrame.Button_ShowBank_OnClick(self, button, down);
          </OnClick>
          <OnEnter>
            TFuBag.NewbieTip(self, TFuBag.LOCALE["Toggle Bank"], 1.0, 1.0, 1.0, TFuBag.LOCALE["Displays bank contents in a view-only mode.  You may select another player's bank to view from the dropdown."]);
          </OnEnter>
          <OnLeave>
            GameTooltip:Hide();
            ResetCursor();
          </OnLeave>
        </Scripts>
      </Button>

      <Button name="TFuInv_Button_Reload">
        <Size><AbsDimension x="20" y="20"/></Size>
        <NormalTexture file="Interface\Icons\Spell_Frost_Stun" />
        <PushedTexture file="Interface\Icons\Spell_Frost_Stun" />
        <HighlightTexture file="Interface\Icons\Spell_Frost_Stun" alphaMode="ADD" />
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="TFuInv_Button_ShowBank" relativePoint="TOPRIGHT">
            <Offset>
              <AbsDimension x="2" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            TFuInvFrame.Button_Reload_OnClick(self, button, down);
          </OnClick>
          <OnEnter>
            TFuBag.NewbieTip(self, TFuBag.LOCALE["Reload and Sort"], 1.0, 1.0, 1.0, TFuBag.LOCALE["Reloads your items and sorts them."]);
          </OnEnter>
          <OnLeave>
            GameTooltip:Hide();
            ResetCursor();
          </OnLeave>
        </Scripts>
      </Button>

    <EditBox name="TFuInv_SearchBox" inherits="TFuBag_SearchBoxTemplate">
        <Anchors>
          <Anchor point="BOTTOMLEFT">
            <Offset>
              <AbsDimension x="10" y="4"/>
            </Offset>
          </Anchor>
        </Anchors>
    </EditBox>

      <CheckButton name="TFuInvacterBag4Slot" inherits="TFuBag_BagButtonTemplate" id="5">
        <Anchors>
          <Anchor point="BOTTOMLEFT" relativeTo="$parent_Total" relativePoint="BOTTOMRIGHT">
            <Offset>
              <AbsDimension x="14" y="-1" />
            </Offset>
          </Anchor>
        </Anchors>
      </CheckButton>
      <CheckButton name="TFuInvacterBag3Slot" inherits="TFuBag_BagButtonTemplate" id="4">
        <Anchors>
          <Anchor point="BOTTOMLEFT" relativeTo="TFuInvacterBag4Slot" relativePoint="BOTTOMRIGHT">
            <Offset>
              <AbsDimension x="3" y="0" />
            </Offset>
          </Anchor>
        </Anchors>
      </CheckButton>
      <CheckButton name="TFuInvacterBag2Slot" inherits="TFuBag_BagButtonTemplate" id="3">
        <Anchors>
          <Anchor point="BOTTOMLEFT" relativeTo="TFuInvacterBag3Slot" relativePoint="BOTTOMRIGHT">
            <Offset>
              <AbsDimension x="3" y="0" />
            </Offset>
          </Anchor>
        </Anchors>
      </CheckButton>
      <CheckButton name="TFuInvacterBag1Slot" inherits="TFuBag_BagButtonTemplate" id="2">
        <Anchors>
          <Anchor point="BOTTOMLEFT" relativeTo="TFuInvacterBag2Slot" relativePoint="BOTTOMRIGHT">
            <Offset>
              <AbsDimension x="3" y="0" />
            </Offset>
          </Anchor>
        </Anchors>
      </CheckButton>
      <CheckButton name="TFuInvacterBag0Slot" inherits="TFuBag_BagButtonTemplate" id="1">
        <Anchors>
          <Anchor point="BOTTOMLEFT" relativeTo="TFuInvacterBag1Slot" relativePoint="BOTTOMRIGHT">
            <Offset>
              <AbsDimension x="3" y="0" />
            </Offset>
          </Anchor>
        </Anchors>
      </CheckButton>


      <CheckButton name="TFuInvMenuBarBackpackButton" inherits="TFuBag_BagButtonTemplate" id="0">
        <Anchors>
          <Anchor point="LEFT" relativeTo="TFuInvacterBag0Slot" relativePoint="RIGHT">
            <Offset>
              <AbsDimension x="3" y="0" />
            </Offset>
          </Anchor>
        </Anchors>
      </CheckButton>

      <CheckButton name="TFuInvingButton" hidden="false" inherits="TFuBag_BagButtonTemplate">
        <Anchors>
          <Anchor point="BOTTOMLEFT" relativeTo="TFuInvMenuBarBackpackButton" relativePoint="BOTTOMRIGHT">
            <Offset>
              <AbsDimension x="4" y="0" />
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnLoad>
            if (select(4,GetBuildInfo()) &gt;= 40200) then 
              self:Hide()
              return
            end
            TFuBag.BagButton.OnLoad(self)
            self:SetID(KEYRING_CONTAINER)
          </OnLoad>
        </Scripts>
      </CheckButton>

  <Frame name="TFuInvainerFrame12" inherits="TFuBagainerFrameTemplate" id="0"/>
  <Frame name="TFuInvainerFrame13" inherits="TFuBagainerFrameTemplate" id="-2"/>
  <Frame name="TFuInvainerFrame1" inherits="TFuBagainerFrameTemplate" id="1"/>
  <Frame name="TFuInvainerFrame2" inherits="TFuBagainerFrameTemplate" id="2"/>
  <Frame name="TFuInvainerFrame3" inherits="TFuBagainerFrameTemplate" id="3"/>
  <Frame name="TFuInvainerFrame4" inherits="TFuBagainerFrameTemplate" id="4"/>
  <Frame name="TFuInvainerFrame5" inherits="TFuBagainerFrameTemplate" id="5"/>

      <Frame name="$parent_RightClickMenu" inherits="UIDropDownMenuTemplate" id="5" hidden="true">
        <Scripts>
          <OnLoad>
            self:RegisterEvent("VARIABLES_LOADED");
          </OnLoad>
          <OnEvent>
            TFuBag.Inv.RightClickMenu_OnLoad(self);
          </OnEvent>
        </Scripts>
      </Frame>
    </Frames>
  </Frame>
</Ui>
