<!-- $Id$ -->
<Ui xmlns="http://www.blizzard.com/wow/ui/"   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"   xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
  <Script file="TBag.lua"/>
  <Script file="TBagCmd.lua"/>
  <Script file="Hooks.lua"/>
  <Script file="TBagOpt.lua"/>
  <Script file="Professions.lua"/>
  <Script file="TBagItemInfo.lua"/>
  <Script file="Events.lua"/>
  <Script file="TBagTest.lua"/>

  <Texture name="TFuBag_ButtonBkgrTemplate" alphaMode="ADD" file="Interface\AddOns\tbag-fufu\images\ButtonBkgr" setAllPoints="true" virtual="true">
    <Size>
      <AbsDimension x="64" y="64"/>
    </Size>
  </Texture>

  <Frame name="TFuBagainerFrameTemplate" frameStrata="MEDIUM" enableMouse="true" virtual="true">
    <Size>
      <AbsDimension x="40" y="40"/>
    </Size>
  </Frame>

  <Frame name="TFuBag_BarFrameTemplate" inherits="BackdropTemplate" toplevel="false" frameStrata="MEDIUM" movable="false" enableMouse="false" hidden="true" virtual="true">
    <Size><AbsDimension x="200" y="46"/></Size>
    <Anchors>
      <Anchor point="BOTTOMRIGHT">
        <Offset>
          <AbsDimension x="0" y="0"/>
        </Offset>
      </Anchor>
    </Anchors>

    <!-- Category name label, shown above the bar when "Show Category Names" is on.
         Anchored bottom-left to the bar's top-left so it sits in the reserved gap
         above the bar (LayoutWindow sets its text/width and reserves the room). -->
    <Layers>
      <Layer level="OVERLAY">
        <FontString parentKey="CatName" inherits="GameFontNormalSmall" justifyH="LEFT" hidden="true">
          <Anchors>
            <Anchor point="BOTTOMLEFT" relativePoint="TOPLEFT">
              <Offset><AbsDimension x="2" y="1"/></Offset>
            </Anchor>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>

    <!-- Inline <Backdrop> was removed from XML in 9.0; set it via the 12.0
         BackdropTemplate mixin instead. inherit="append" keeps the template's
         own OnLoad (mixin setup) running first. -->
    <Scripts>
      <OnLoad inherit="append">
        self:SetBackdrop({
          bgFile = "Interface\\Tooltips\\UI-Tooltip-Background",
          edgeFile = "Interface\\Tooltips\\UI-Tooltip-Border",
          tile = true, tileSize = 4, edgeSize = 4,
          insets = { left = 2, right = 2, top = 2, bottom = 2 },
        })
      </OnLoad>
    </Scripts>
  </Frame>

  <Frame name="TFuBag_UserDropdownTemplate" inherits="UIDropDownMenuTemplate" enableMouse="true" virtual="true">
  <Scripts>
    <OnEnter>
      GameTooltip:SetOwner(self, "ANCHOR_TOPRIGHT");
      GameTooltip:SetText(self.tooltip, nil, nil, nil, nil, 1);
    </OnEnter>
    <OnLeave>
      GameTooltip:Hide();
      ResetCursor();
    </OnLeave>
  </Scripts>
  </Frame>

  <EditBox name="TFuBag_SearchBoxTemplate" inherits="InputBoxTemplate" hidden="false" virtual="true" autoFocus="false">
    <Size><AbsDimension x="198" y="30"/></Size>
    <Scripts>
      <OnShow>
        TFuBag:ClearSearch();
      </OnShow>
      <OnTabPressed>
        self:ClearFocus();
      </OnTabPressed>
      <OnEscapePressed>
        self:ClearFocus();
      </OnEscapePressed>
      <OnEnterPressed>
        if (self:GetText() ~= "") then
          TFuBag:DoSearch(self:GetText());
        end
        self:ClearFocus();
      </OnEnterPressed>
      <OnEditFocusLost>
        self:HighlightText(0, 0);
        if ( self:GetText() == "" ) then
          TFuBag:ClearSearch();
        end
      </OnEditFocusLost>
      <OnEditFocusGained>
        self:HighlightText(0, 0);
        if ( self:GetText() == SEARCH ) then
          self:SetText("");
        end
      </OnEditFocusGained>
    </Scripts>
  </EditBox>
</Ui>
