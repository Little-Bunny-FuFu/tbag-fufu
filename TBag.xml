<!-- $Id$ -->
<Ui xmlns="http://www.blizzard.com/wow/ui/"   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"   xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
  <Script file="TBag.lua"/>
  <Script file="TBagCmd.lua"/>
  <Script file="TBagHook.lua"/>
  <Script file="TBagOpt.lua"/>
  <Script file="TBagTrade.lua"/>
  <Script file="TBagItemInfo.lua"/>
  <Script file="TBagTest.lua"/>

  <FontString name="TBag_BigFont"  font="Interface\AddOns\TBag\DAB_CooldownFont.ttf" virtual="true" justifyH="CENTER">
    <Shadow>
      <Offset>
        <AbsDimension x="1" y="-1"/>
      </Offset>
      <Color r="0" g="0" b="0"/>
    </Shadow>
    <FontHeight>
      <AbsValue val="16"/>
    </FontHeight>
    <Color r="1" g="0" b="0.25"/>
  </FontString>

  <Texture name="TBag_ButtonBkgrTemplate" alphaMode="ADD" file="Interface\AddOns\TBag\images\ButtonBkgr" setAllPoints="true" virtual="true">
    <Size>
      <AbsDimension x="64" y="64"/>
    </Size>
  </Texture>  

  <Frame name="TBagainerFrameTemplate" frameStrata="MEDIUM" enableMouse="true" virtual="true">
    <Size>
      <AbsDimension x="40" y="40"/>
    </Size>
  </Frame>

  <Frame name="TBag_BarFrameTemplate" toplevel="false" frameStrata="MEDIUM" movable="false" enableMouse="false" hidden="true" virtual="true"> 
    <Size><AbsDimension x="200" y="46"/></Size>
    <Anchors>
      <Anchor point="BOTTOMRIGHT">
        <Offset>
          <AbsDimension x="0" y="0"/>
        </Offset>
      </Anchor>
    </Anchors>

    <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
      <EdgeSize>
        <AbsValue val="4"/>
      </EdgeSize>
      <TileSize>
        <AbsValue val="4"/>
      </TileSize>
      <BackgroundInsets>
        <AbsInset left="2" right="2" top="2" bottom="2"/>
      </BackgroundInsets>
    </Backdrop>
  </Frame>

  <Frame name="TBag_UserDropdownTemplate" inherits="UIDropDownMenuTemplate" enableMouse="true" virtual="true">
  <Scripts>
    <OnEnter>
      GameTooltip:SetOwner(this, "ANCHOR_TOPRIGHT");
      GameTooltip:SetText(this.tooltip, nil, nil, nil, nil, 1);
    </OnEnter>
    <OnLeave>
      GameTooltip:Hide();
      ResetCursor();
    </OnLeave>
  </Scripts>
  </Frame>

  <EditBox name="TBag_SearchBoxTemplate" inherits="InputBoxTemplate" hidden="false" virtual="true" autoFocus="false">
    <Size><AbsDimension x="190" y="30"/></Size>
    <Scripts>
      <OnShow>
        TBag_ClearSearch();
      </OnShow>
      <OnTabPressed>
        this:ClearFocus();
      </OnTabPressed>
      <OnEscapePressed>
        this:ClearFocus();
      </OnEscapePressed>
      <OnEnterPressed>
        if (this:GetText() ~= "") then    
	  TBag_DoSearch(this:GetText());
	end
        this:ClearFocus();
      </OnEnterPressed>
      <OnEditFocusLost>
        this:HighlightText(0, 0);
        if ( this:GetText() == "" ) then
          TBag_ClearSearch();
        end
      </OnEditFocusLost>
      <OnEditFocusGained>
        this:HighlightText(0, 0);
        if ( this:GetText() == SEARCH ) then
          this:SetText("");
        end
      </OnEditFocusGained>
    </Scripts>
  </EditBox>
</Ui>
