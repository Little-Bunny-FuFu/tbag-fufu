<!-- $Id$ -->
<Ui xmlns="http://www.blizzard.com/wow/ui/"   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"   xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
  <Script file="TBnkTabSettings.lua"/>

  <!-- Bank tab settings dialog, built on Blizzard's shared IconSelectorPopupFrameTemplate
       (the same template the Macro UI, Guild Bank, and Blizzard's own bank tab settings
       use). The mixin (TBnkTabSettings.lua) adds the deposit checkboxes + expansion filter
       and applies via C_Bank.UpdateBankTabSettings. Parented to UIParent so it is a free
       standalone window at full opacity, frameStrata HIGH to match the inherited icon grid. -->
  <Frame name="TFuBnk_TabSettingsDialog" mixin="TFuBnkTabSettingsMixin" inherits="IconSelectorPopupFrameTemplate" parent="UIParent" frameStrata="FULLSCREEN_DIALOG" enableMouse="true" hidden="true">
    <KeyValues>
      <KeyValue key="editBoxHeaderText" value="CHARACTER_BANK_TAB_NAME_PROMPT" type="global"/>
    </KeyValues>
    <Anchors>
      <Anchor point="CENTER"/>
    </Anchors>
  </Frame>
</Ui>
