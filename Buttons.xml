<!-- $Id$ -->
<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
  <Script file="Buttons.lua"/>

    <Button name="TFuBag_EditButtonTemplate" hidden="true" virtual="true" setAllPoints="true">
      <Size><AbsDimension x="40" y="40"/></Size>
      <Scripts>
        <OnLoad>
          self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
        </OnLoad>
        <OnClick>
          TFuBag.ItemButton.OnClick(self, button, down);
        </OnClick>
        <OnEnter>
          TFuBag.ItemButton.OnEnter(self, motion);
        </OnEnter>
        <OnLeave>
          TFuBag.ItemButton.OnLeave(self, motion);
        </OnLeave>
      </Scripts>
    </Button>

    <Button name="TFuBag_ItemButtonTemplate" inherits="ContainerFrameItemButtonTemplate" hidden="true" virtual="true">
      <Size><AbsDimension x="40" y="40"/></Size>
      <Frames>
        <Button name="$parent_EditButton" inherits="TFuBag_EditButtonTemplate"/>
        <Frame name="$parentHighlightFrame" setAllPoints="true">
          <Layers>
            <Layer>
              <Texture name="$parentTexture" alphaMode="ADD" file="Interface\Buttons\CheckButtonHilight" setAllPoints="true" hidden="true"/>
          </Layer>
        </Layers>
      </Frame>
    </Frames>
    <Layers>
      <Layer level="BORDER">
        <Texture name="$parent_bkgr" inherits="TFuBag_ButtonBkgrTemplate"/>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad>
        if ContainerFrameItemButton_OnLoad then ContainerFrameItemButton_OnLoad(self); end  -- removed in 12.0; ItemButton mixin self-inits
        self.UpdateTooltip = TFuBag.ItemButton.OnEnter;
        local newitem = _G[self:GetName() .. "NewItemTexture"]
        if newitem then
          newitem:Hide();
        end
        local battlepay = _G[self:GetName()].BattlepayItemTexture;
        if battlepay then
          battlepay:Hide();
        end
      </OnLoad>
      <OnEnter>
        TFuBag.ItemButton.OnEnter(self, motion);
      </OnEnter>
      <OnLeave>
        TFuBag.ItemButton.OnLeave(self, motion);
      </OnLeave>
    </Scripts>
  </Button>

  <!-- 12.0: old ItemButtonTemplate is now the "ItemButton" intrinsic; use it directly. -->
  <ItemButton name="TFuBag_BarButtonTemplate" hidden="true" virtual="true">
    <Size><AbsDimension x="40" y="40"/></Size>
    <Layers>
      <Layer level="BORDER">
        <Texture name="$parent_bkgr" inherits="TFuBag_ButtonBkgrTemplate"/>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad>
        TFuBag.BarButton.OnLoad(self)
      </OnLoad>
      <OnClick>
        TFuBag.BarButton.OnClick(self, button, down)
      </OnClick>
      <OnEnter>
        TFuBag.BarButton.OnEnter(self, motion)
      </OnEnter>
      <OnLeave>
        TFuBag.BarButton.OnLeave(self, motion)
      </OnLeave>
    </Scripts>
  </ItemButton>

  <CheckButton name="TFuBag_BagButtonTemplate" inherits="ItemButtonTemplate" virtual="true">
    <Frames>
      <Frame name="$parentSpotlight" setAllPoints="true">
        <Layers>
          <Layer>
            <Texture name="$parentTexture" alphaMode="ADD" file="Interface\Buttons\CheckButtonHilight" setAllPoints="true" hidden="true"/>
          </Layer>
        </Layers>
      </Frame>
      <Model name="$parentItemAnim" inherits="ItemAnimTemplate" setAllPoints="true">
        <Scripts>
          <OnEvent>
            TFuBag.BagButton.ItemAnimOnEvent(self,event,...)
          </OnEvent>
        </Scripts>
      </Model>
    </Frames>
    <CheckedTexture alphaMode="ADD" file="Interface\Buttons\CheckButtonHilight"/>
    <Scripts>
      <OnLoad>
        TFuBag.BagButton.OnLoad(self)
      </OnLoad>
      <OnEnter>
        TFuBag.BagButton.OnEnter(self)
      </OnEnter>
      <OnLeave>
        TFuBag.BagButton.OnLeave(self)
      </OnLeave>
      <OnClick>
        TFuBag.BagButton.OnClick(self,button,down,false)
      </OnClick>
      <OnDragStart>
        TFuBag.BagButton.OnDrag(self,button)
      </OnDragStart>
      <OnReceiveDrag>
        TFuBag.BagButton.OnClick(self,"LeftButton",false,true)
      </OnReceiveDrag>
    </Scripts>
  </CheckButton>

  <Frame name="TFuBag_TotalTemplate" virtual="true">
    <Size><AbsDimension x="28" y="28"/></Size>
    <Layers>
      <Layer level="ARTWORK">
        <FontString name="$parentText" font="Fonts\ARIALN.TTF" justifyH="CENTER" outline="NORMAL">
          <Anchors>
            <Anchor point="CENTER"/>
          </Anchors>
          <FontHeight><AbsValue val="18"/></FontHeight>
          <Color r="1" g="0" b="0.25"/>
        </FontString>
      </Layer>
    </Layers>
  </Frame>

  <Button name="TFuBag_ColumnsButtonTemplate" inherits="GameMenuButtonTemplate" virtual="true">
    <Size><AbsDimension x="45" y="22"/></Size>
    <Anchors>
      <Anchor point="BOTTOM" relativePoint="BOTTOM">
        <Offset><AbsDimension x="0" y="5"/></Offset>
      </Anchor>
    </Anchors>
    <Scripts>
      <OnLoad>
        TFuBag.ColumnsButton.OnLoad(self)
      </OnLoad>
      <OnClick>
        TFuBag.ColumnsButton.OnClick(self,button,down)
      </OnClick>
      <OnEnter>
        TFuBag.ColumnsButton.OnEnter(self)
      </OnEnter>
      <OnLeave>
        TFuBag.ColumnsButton.OnLeave(self)
      </OnLeave>
    </Scripts>
  </Button>

  <Button name="TFuBag_CloseTemplate" virtual="true">
    <Size><AbsDimension x="34" y="34"/></Size>
    <NormalTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Up"/>
    <PushedTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Down"/>
    <HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD"/>
    <Scripts>
      <OnClick>
        self:GetParent():Close()
      </OnClick>
    </Scripts>
  </Button>

  <Button name="TFuBag_MoveLockTemplate" virtual="true">
    <Size><AbsDimension x="34" y="34"/></Size>
    <NormalTexture name="$parent_NormTexture"/>
    <PushedTexture name="$parent_PushTexture"/>
    <HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD"/>
    <Scripts>
      <OnClick>
        self:GetParent():Button_MoveLockToggle_OnClick(button, down)
      </OnClick>
      <OnEnter>
        if self:GetParent().cfg.moveLock == 0 then
          GameTooltip_AddNewbieTip(self, TFuBag.LOCALE["Unlock Window"], 1.0, 1.0, 1.0,
            TFuBag.LOCALE["Allow window to be moved by dragging it."])
        else
          GameTooltip_AddNewbieTip(self, TFuBag.LOCALE["Lock Window"], 1.0, 1.0, 1.0,
            TFuBag.LOCALE["Prevent window from being moved by dragging it."])
        end
      </OnEnter>
      <OnLeave>
        GameTooltip:Hide();
        ResetCursor();
      </OnLeave>
    </Scripts>
  </Button>

</Ui>
