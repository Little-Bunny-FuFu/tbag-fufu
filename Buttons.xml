<!-- $Id$ -->
<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
  <Script file="Buttons.lua"/>

    <Button name="TFuBag_EditButtonTemplate" hidden="true" virtual="true" setAllPoints="true">
      <Size><AbsDimension x="40" y="40"/></Size>
      <Scripts>
        <OnLoad>
          self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
        </OnLoad>
        <OnClick>
          TFuBag.ItemButton.OnClick(self, button, down);
        </OnClick>
        <OnEnter>
          TFuBag.ItemButton.OnEnter(self, motion);
        </OnEnter>
        <OnLeave>
          TFuBag.ItemButton.OnLeave(self, motion);
        </OnLeave>
      </Scripts>
    </Button>

    <!-- 12.0: declare as the ItemButton intrinsic (not <Button inherits=...>) so
         the intrinsic's children (IconTexture/Count/Stock/NormalTexture) get their
         $parent global names; a plain <Button> only partially instantiates them. -->
    <ItemButton name="TFuBag_ItemButtonTemplate" inherits="ContainerFrameItemButtonTemplate" hidden="true" virtual="true">
      <Size><AbsDimension x="40" y="40"/></Size>
      <Frames>
        <Button name="$parent_EditButton" inherits="TFuBag_EditButtonTemplate"/>
        <Frame name="$parentHighlightFrame" setAllPoints="true">
          <Layers>
            <Layer>
              <Texture name="$parentTexture" alphaMode="ADD" file="Interface\Buttons\CheckButtonHilight" setAllPoints="true" hidden="true"/>
          </Layer>
        </Layers>
      </Frame>
    </Frames>
    <Layers>
      <Layer level="BORDER">
        <Texture name="$parent_bkgr" inherits="TFuBag_ButtonBkgrTemplate"/>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad>
        self:RegisterForClicks("LeftButtonUp", "RightButtonUp");
        self:RegisterForDrag("LeftButton");  -- 12.0: needed for drag-to-pickup (OnDragStart -> OnClick)
        self.UpdateTooltip = TFuBag.ItemButton.OnEnter;
        local newitem = _G[self:GetName() .. "NewItemTexture"]
        if newitem then
          newitem:Hide();
        end
        local battlepay = _G[self:GetName()].BattlepayItemTexture;
        if battlepay then
          battlepay:Hide();
        end
      </OnLoad>
      <!-- NO <OnClick> here: defining one would REPLACE the inherited
           ContainerFrameItemButtonTemplate OnClick with an insecure Lua handler,
           putting tbag on the call stack and tainting the protected
           C_Container.UseContainerItem inside it (ADDON_ACTION_FORBIDDEN when
           using a consumable). Keep Blizzard's inherited secure OnClick for
           use/pickup; add only our extra behavior via PreClick below. -->
      <PreClick>
        TFuBag.ItemButton.PreClick(self, button);
      </PreClick>
      <OnEnter>
        TFuBag.ItemButton.OnEnter(self, motion);
      </OnEnter>
      <OnLeave>
        TFuBag.ItemButton.OnLeave(self, motion);
      </OnLeave>
    </Scripts>
  </ItemButton>

  <!-- 12.0: old ItemButtonTemplate is now the "ItemButton" intrinsic; use it directly. -->
  <ItemButton name="TFuBag_BarButtonTemplate" hidden="true" virtual="true">
    <Size><AbsDimension x="40" y="40"/></Size>
    <Layers>
      <Layer level="BORDER">
        <Texture name="$parent_bkgr" inherits="TFuBag_ButtonBkgrTemplate"/>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad>
        TFuBag.BarButton.OnLoad(self)
      </OnLoad>
      <OnClick>
        TFuBag.BarButton.OnClick(self, button, down)
      </OnClick>
      <OnEnter>
        TFuBag.BarButton.OnEnter(self, motion)
      </OnEnter>
      <OnLeave>
        TFuBag.BarButton.OnLeave(self, motion)
      </OnLeave>
    </Scripts>
  </ItemButton>

  <!-- 12.0: ItemButtonTemplate is now the "ItemButton" intrinsic, which a
       CheckButton cannot inherit. Replicate the item-button children (icon /
       count / stock / normaltexture, mirroring the intrinsic) so the bag
       selector keeps its visuals while staying a CheckButton (the code relies
       on Get/SetChecked). ItemAnimTemplate is also gone; keep the Model as a
       placeholder (only ItemAnimOnEvent references it, no load-time use). -->
  <CheckButton name="TFuBag_BagButtonTemplate" mixin="ItemButtonMixin" virtual="true">
    <Size><AbsDimension x="37" y="37"/></Size>
    <Layers>
      <Layer level="BORDER">
        <Texture name="$parentIconTexture" parentKey="icon" setAllPoints="true"/>
      </Layer>
      <Layer level="ARTWORK">
        <FontString name="$parentCount" inherits="NumberFontNormal" justifyH="RIGHT" hidden="true" parentKey="Count">
          <Anchors><Anchor point="BOTTOMRIGHT" x="-5" y="2"/></Anchors>
        </FontString>
        <FontString name="$parentStock" parentKey="Stock" inherits="NumberFontNormalYellow" justifyH="LEFT" hidden="true">
          <Anchors><Anchor point="TOPLEFT" x="0" y="-2"/></Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <Frame name="$parentSpotlight" setAllPoints="true">
        <Layers>
          <Layer>
            <Texture name="$parentTexture" alphaMode="ADD" file="Interface\Buttons\CheckButtonHilight" setAllPoints="true" hidden="true"/>
          </Layer>
        </Layers>
      </Frame>
      <Model name="$parentItemAnim" setAllPoints="true">
        <Scripts>
          <OnEvent>
            TFuBag.BagButton.ItemAnimOnEvent(self,event,...)
          </OnEvent>
        </Scripts>
      </Model>
    </Frames>
    <NormalTexture name="$parentNormalTexture" parentKey="NormalTexture" file="Interface\Buttons\UI-Quickslot2">
      <Size><AbsDimension x="64" y="64"/></Size>
      <Anchors><Anchor point="CENTER" x="0" y="-1"/></Anchors>
    </NormalTexture>
    <CheckedTexture alphaMode="ADD" file="Interface\Buttons\CheckButtonHilight"/>
    <Scripts>
      <OnLoad>
        TFuBag.BagButton.OnLoad(self)
      </OnLoad>
      <OnEnter>
        TFuBag.BagButton.OnEnter(self)
      </OnEnter>
      <OnLeave>
        TFuBag.BagButton.OnLeave(self)
      </OnLeave>
      <OnClick>
        TFuBag.BagButton.OnClick(self,button,down,false)
      </OnClick>
      <OnDragStart>
        TFuBag.BagButton.OnDrag(self,button)
      </OnDragStart>
      <OnReceiveDrag>
        TFuBag.BagButton.OnClick(self,"LeftButton",false,true)
      </OnReceiveDrag>
    </Scripts>
  </CheckButton>

  <Frame name="TFuBag_TotalTemplate" virtual="true">
    <Size><AbsDimension x="28" y="28"/></Size>
    <Layers>
      <Layer level="ARTWORK">
        <FontString name="$parentText" font="Fonts\ARIALN.TTF" justifyH="CENTER" outline="NORMAL">
          <Anchors>
            <Anchor point="CENTER"/>
          </Anchors>
          <FontHeight><AbsValue val="18"/></FontHeight>
          <Color r="1" g="0" b="0.25"/>
        </FontString>
      </Layer>
    </Layers>
  </Frame>

  <Button name="TFuBag_ColumnsButtonTemplate" inherits="GameMenuButtonTemplate" virtual="true">
    <Size><AbsDimension x="45" y="22"/></Size>
    <Anchors>
      <Anchor point="BOTTOM" relativePoint="BOTTOM">
        <Offset><AbsDimension x="0" y="5"/></Offset>
      </Anchor>
    </Anchors>
    <Scripts>
      <OnLoad>
        TFuBag.ColumnsButton.OnLoad(self)
      </OnLoad>
      <OnClick>
        TFuBag.ColumnsButton.OnClick(self,button,down)
      </OnClick>
      <OnEnter>
        TFuBag.ColumnsButton.OnEnter(self)
      </OnEnter>
      <OnLeave>
        TFuBag.ColumnsButton.OnLeave(self)
      </OnLeave>
    </Scripts>
  </Button>

  <Button name="TFuBag_CloseTemplate" virtual="true">
    <Size><AbsDimension x="34" y="34"/></Size>
    <NormalTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Up"/>
    <PushedTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Down"/>
    <HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD"/>
    <Scripts>
      <OnClick>
        self:GetParent():Close()
      </OnClick>
    </Scripts>
  </Button>

  <Button name="TFuBag_MoveLockTemplate" virtual="true">
    <Size><AbsDimension x="34" y="34"/></Size>
    <NormalTexture name="$parent_NormTexture"/>
    <PushedTexture name="$parent_PushTexture"/>
    <HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD"/>
    <Scripts>
      <OnClick>
        self:GetParent():Button_MoveLockToggle_OnClick(button, down)
      </OnClick>
      <OnEnter>
        if self:GetParent().cfg.moveLock == 0 then
          TFuBag.NewbieTip(self, TFuBag.LOCALE["Unlock Window"], 1.0, 1.0, 1.0,
            TFuBag.LOCALE["Allow window to be moved by dragging it."])
        else
          TFuBag.NewbieTip(self, TFuBag.LOCALE["Lock Window"], 1.0, 1.0, 1.0,
            TFuBag.LOCALE["Prevent window from being moved by dragging it."])
        end
      </OnEnter>
      <OnLeave>
        GameTooltip:Hide();
        ResetCursor();
      </OnLeave>
    </Scripts>
  </Button>

</Ui>
